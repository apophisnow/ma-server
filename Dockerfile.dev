# Development Dockerfile for Music Assistant Server
# This is a simplified version for local development and testing

FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# First, install the local models package
COPY models /models
RUN pip install -e /models

# Install Python dependencies (excluding music-assistant-models since we installed it above)
COPY ma-server/requirements_all.txt .
RUN grep -v "music-assistant-models" requirements_all.txt > requirements_filtered.txt && \
    pip install --no-cache-dir -r requirements_filtered.txt

# Copy the server code
COPY ma-server .

# Install Music Assistant in development mode (without upgrading already installed packages)
RUN pip install -e . --no-deps && \
    pip install -r requirements_filtered.txt

# Create data directory
RUN mkdir -p /data

# Expose the server port
EXPOSE 8095

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Copy startup script
COPY ma-server/start-dev.sh /start-dev.sh
RUN chmod +x /start-dev.sh

# Start the server
CMD ["/start-dev.sh"]
